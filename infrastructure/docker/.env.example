# ============================================================================
# Fleet Platform - Docker Compose Environment Template
# ============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env with sensitive values (use .env.example as template)
#
# IMPORTANT: .env values take precedence over environment variables
# For production, use secure secret management (AWS Secrets Manager, etc.)

# ============================================================================
# Frontend Service Configuration
# ============================================================================
# React + Vite dashboard for fleet monitoring portal

# Port for frontend dev server (Vite)
FRONTEND_PORT=3000

# Backend API base URL (as seen from browser)
# Local development: http://localhost:8080
# Production: https://api.example.com
VITE_API_BASE_URL=http://localhost:8080

# Server-Sent Events endpoint for real-time updates
# Format: http://hostname:port/api/vehicles/updates
VITE_SSE_ENDPOINT=http://localhost:8080/api/vehicles/updates

# Data source mode for frontend
# Options: mock (local fixtures for offline dev), api (live backend)
VITE_DATA_MODE=mock

# Mapbox API token for interactive map visualization
# Get token from: https://account.mapbox.com/tokens/
# Leave empty to disable map features (optional)
# Example: pk.eyJ1IjoieW91cmlkIiwgImEiOiJjbXZ...rest_of_token
VITE_MAPBOX_TOKEN=

# ============================================================================
# Zookeeper Configuration
# ============================================================================
# Coordination service for Kafka metadata management
ZOOKEEPER_CLIENT_PORT=2181

# ============================================================================
# Kafka Configuration
# ============================================================================
# Event bus for decoupled telemetry ingestion and processing
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=telemetry.positions
KAFKA_GROUP_ID=fleet-worker-group

# ============================================================================
# TimescaleDB Configuration
# ============================================================================
# PostgreSQL with TimescaleDB extension for time-series telemetry storage

POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=fleet_password
POSTGRES_DB=fleet_db

# Port mapping: host:container
# Default 5433 to avoid conflicts with local PostgreSQL on 5432
TIMESCALEDB_PORT=5433

# Internal Docker network hostname (for services inside compose)
DB_HOST=timescaledb

# Database port on internal network (standard PostgreSQL)
DB_PORT=5432

# SSL mode for database connections
# Options: disable, allow, prefer, require, verify-ca, verify-full
# Development: prefer (negotiate SSL if available, fallback to unencrypted)
DB_SSLMODE=prefer

# ============================================================================
# Ingestion API Configuration
# ============================================================================
# HTTP service for receiving telemetry from mobile devices

HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=30s

# ============================================================================
# Worker Configuration
# ============================================================================
# Background event processor (Kafka consumer -> TimescaleDB)

WORKER_SHUTDOWN_TIMEOUT=30s

# ============================================================================
# Logging Configuration
# ============================================================================
# Applied to all backend services (ingestion, worker, migrate)

# Log level: debug (very verbose), info (standard), warn, error (critical only)
LOG_LEVEL=info

# Log format: json (machine-readable), text (human-readable)
LOG_FORMAT=json

