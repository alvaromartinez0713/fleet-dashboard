# ============================================================================
# Fleet Platform - Docker Compose Environment Template
# ============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env with sensitive values (use .env.example as template)

# ============================================================================
# Zookeeper Configuration
# ============================================================================
# Coordination service for Kafka metadata management
ZOOKEEPER_CLIENT_PORT=2181

# ============================================================================
# Kafka Configuration
# ============================================================================
# Event bus for decoupled telemetry ingestion and processing
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=telemetry.positions

# ============================================================================
# TimescaleDB Configuration
# ============================================================================
# PostgreSQL with TimescaleDB extension for time-series telemetry
POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fleet_db

# Port mapping: host:container (change to 5433 if 5432 is already in use)
TIMESCALEDB_PORT=5432

# Local host DNS (for connecting from host machine)
DB_HOST=localhost

# ============================================================================
# HTTP API Configuration
# ============================================================================
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=30s

# ============================================================================
# Logging Configuration
# ============================================================================
# Options: debug, info, warn, error
LOG_LEVEL=info

# Options: json, text
LOG_FORMAT=json

# ============================================================================
# Worker Configuration
# ============================================================================
# Background event processor (Kafka consumer)
WORKER_SHUTDOWN_TIMEOUT=30s
