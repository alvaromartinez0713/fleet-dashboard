# Development Configuration Example
# Copy to .env.local and customize for your environment

# Data mode: 'mock' (local mock data) or 'api' (real backend)
VITE_DATA_MODE=mock

# API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_SSE_ENDPOINT=http://localhost:8080/api/vehicles/updates

# Mapbox Access Token (get from https://account.mapbox.com/tokens/)
# Required for interactive map display
# Free tier: 50,000 map loads/month
VITE_MAPBOX_TOKEN=pk.eyJ...your_token_here
