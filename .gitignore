# ============================================================================
# Fleet Platform - Root .gitignore
# ============================================================================
# This file contains general patterns for the entire monorepo.
# Project-specific patterns are in each subdirectory's .gitignore.
# ============================================================================

# ----------------------------------------------------------------------------
# Environment and Secrets
# ----------------------------------------------------------------------------
# Environment variables
# .env files contain sensitive configuration (passwords, ports, API keys, etc.)
# Never commit .env to git; use .env.example as template instead
# NEVER commit environment files with real secrets
.env
.env.local
.env.*.local
*.env

# ----------------------------------------------------------------------------
# IDE and Editor
# ----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs (IntelliJ, GoLand, WebStorm, etc.)
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ----------------------------------------------------------------------------
# Operating System
# ----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------------------------------------------------------
# Logs and Temporary Files
# ----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# ----------------------------------------------------------------------------
# Docker
# ----------------------------------------------------------------------------
# Do NOT ignore docker-compose.yml (it's infrastructure as code)
# Ignore override files for local development only
docker-compose.override.yml
.dockerignore.local

# ----------------------------------------------------------------------------
# Terraform (when added)
# ----------------------------------------------------------------------------
# infrastructure/terraform/.gitignore will handle Terraform-specific patterns

# ----------------------------------------------------------------------------
# Testing and Coverage
# ----------------------------------------------------------------------------
coverage/
*.coverage
.nyc_output/
test-results/
.pytest_cache/

# ----------------------------------------------------------------------------
# Build Artifacts (general)
# ----------------------------------------------------------------------------
dist/
build/
out/

# ----------------------------------------------------------------------------
# Dependencies (general - specific patterns in project .gitignore)
# ----------------------------------------------------------------------------
node_modules/

# ============================================================================
# Note: Project-specific patterns (Go binaries, frontend builds, mobile cache)
# are handled in their respective .gitignore files:
# - backend/go/.gitignore
# - frontend/.gitignore (when created)
# - mobile/.gitignore (when created)
# ============================================================================

# Backend Go - Environment files for production
backend/go/.env.prod
backend/go/.env.local

# NPM Configuration with tokens
# .npmrc may contain authentication tokens for private registries
# Never commit .npmrc files with real credentials
.npmrc
.npmrc.local

# Expo Cache and Local Configuration
# .expo/ contains local Expo configuration and cache
# This is machine-specific and should not be committed
.expo/
.expo-shared/
