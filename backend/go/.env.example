# ============================================================================
# Backend Go Services - Environment Variables
# ============================================================================
# This file contains all environment variables for Go-based microservices.
# Variables are organized by service. Copy this file to .env and fill in
# the actual values. DO NOT commit .env with real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Ingestion Service (cmd/ingestion)
# ----------------------------------------------------------------------------
# HTTP server configuration
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=30s

# Logging configuration (shared by both services)
LOG_LEVEL=info
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# Worker Service (cmd/worker)
# ----------------------------------------------------------------------------
# Worker lifecycle configuration
WORKER_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# Future: Kafka Configuration (to be added in ingestion Spec)
# ----------------------------------------------------------------------------
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=telemetry-events
# KAFKA_CONSUMER_GROUP=worker-processors

# ----------------------------------------------------------------------------
# Future: PostgreSQL/TimescaleDB Configuration (to be added in ingestion Spec)
# ----------------------------------------------------------------------------
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=fleet_user
# PG_PASSWORD=<secret>
# PG_DATABASE=fleet_telemetry
# PG_SSL_MODE=disable
