# ============================================================================
# Environment Template for Fleet Dashboard Backend (Production)
# ============================================================================
# Copy this file and update values for your environment
# DO NOT commit sensitive values - use Secrets Manager or environment injection

# Database (RDS PostgreSQL with TimescaleDB)
DB_HOST=timescaledb.rds.amazonaws.com
DB_PORT=5432
DB_USER=fleet_prod_user
DB_PASSWORD=<change_me>
DB_NAME=fleet_prod_db
DB_SSL=true

# Kafka (Production Event Bus)
KAFKA_BROKERS=kafka-prod-broker:9092
KAFKA_TOPIC=telemetry.positions.prod

# HTTP API
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=30s

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json

# Worker (Background Event Processor)
WORKER_SHUTDOWN_TIMEOUT=30s
