# ============================================================================
# Fleet Platform - Environment Variables Template
# ============================================================================
# Copy this file to .env and adjust values as needed for local development.
# The .env file should NOT be committed to version control.
#
# Usage: cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# TimescaleDB Configuration
# ----------------------------------------------------------------------------
# PostgreSQL user and database credentials
POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=fleet_password
POSTGRES_DB=fleet_db

# Port mapping for external access to TimescaleDB
# Default: 5433 to avoid conflicts with existing PostgreSQL installations
# Change to 5432 if no local PostgreSQL is running
TIMESCALEDB_PORT=5433

# PostgreSQL host authentication method
# Options: trust, scram-sha-256, md5
# Development default: scram-sha-256 (secure password authentication)
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# ----------------------------------------------------------------------------
# Kafka Configuration
# ----------------------------------------------------------------------------
# Kafka broker addresses (internal Docker network)
KAFKA_BROKERS=kafka:9092

# Topic for telemetry position events
KAFKA_TOPIC=telemetry.positions

# Consumer group ID for worker service
KAFKA_GROUP_ID=fleet-worker-group

# ----------------------------------------------------------------------------
# Database Connection (Worker Service)
# ----------------------------------------------------------------------------
# Internal Docker network hostnames
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=fleet_user
DB_PASSWORD=fleet_password
DB_NAME=fleet_db
DB_SSLMODE=disable

# ----------------------------------------------------------------------------
# Ingestion API Configuration
# ----------------------------------------------------------------------------
# HTTP server port (host mapping)
HTTP_PORT=8080

# Timeouts for HTTP server
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# Worker Configuration
# ----------------------------------------------------------------------------
# Graceful shutdown timeout for worker
WORKER_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json, text
LOG_FORMAT=json
