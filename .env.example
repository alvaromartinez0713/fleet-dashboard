# ============================================================================
# Fleet Platform - Environment Configuration Example
# ============================================================================
# Copy this file to .env and customize values for your environment.
# Variables below are injected into docker-compose.yml via ${VAR_NAME:-default}.
# DO NOT commit .env to git (use .env.example instead).
# ============================================================================

# ============================================================================
# HTTP API Configuration
# ============================================================================

# Port where the HTTP API server listens for requests
HTTP_PORT=8080

# Maximum time the server waits to read a complete request from the client
HTTP_READ_TIMEOUT=15s

# Maximum time the server waits to write a complete response to the client
HTTP_WRITE_TIMEOUT=15s

# Maximum time to allow active connections to complete during graceful shutdown
HTTP_SHUTDOWN_TIMEOUT=30s

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: debug, info, warn, error
# Use 'debug' for verbose output during development
# Use 'info' for production (default recommended)
LOG_LEVEL=info

# Log output format: json (recommended for production) or text (human-readable)
LOG_FORMAT=json

# ============================================================================
# Worker Service Configuration
# ============================================================================

# Maximum time to allow worker to complete active tasks during graceful shutdown
WORKER_SHUTDOWN_TIMEOUT=30s

# ============================================================================
# TimescaleDB / PostgreSQL Configuration
# ============================================================================

# Database user for authentication
# Used by the ingestion API and worker to connect to PostgreSQL
POSTGRES_USER=fleet_user

# Database password for the user specified in POSTGRES_USER
# ⚠️  SECURITY WARNING: Change this password in production environments
# Use a strong, randomly generated password and store it securely
POSTGRES_PASSWORD=changeme

# Database name created and used by the application
# This database stores all telemetry and fleet data
POSTGRES_DB=fleet_db

# Port where TimescaleDB/PostgreSQL listens
# Default is 5432. Change this if port conflicts occur with other services
# Make sure firewall rules allow access from your application containers
TIMESCALEDB_PORT=5432

# ============================================================================
# Notes
# ============================================================================
# - Customize values above for your local environment
# - All variables have sensible defaults in docker-compose.yml if not set
# - Never commit actual passwords or sensitive data
# - For production, use a secure secrets management system
# - Review and customize all security-sensitive values before deployment
